#!/bin/sh
# meng-luo 首次启动默认值（ImmortalWrt 24.10）
# 刷机后第一次启动执行一次，成功则从 /etc/uci-defaults 移除
[ -f /etc/config/firewall ] || exit 0

# ---------- 防火墙 ----------
# FullCone NAT：BT / P2P 打洞
# 注意：nft 版 fullcone 只替代非 UDP 的 masq（见 ImmortalWrt 补丁说明），
#       UDP（DHT / uTP）的入站仍然依赖 UPnP
uci -q set firewall.@defaults[0].fullcone='1'
uci -q set firewall.@defaults[0].fullcone6='0'
# flow offloading 保持开启（吞吐优先）。
# SQM 默认不启用；要跑 SQM 时必须先把它关掉，否则 qdisc 会被绕过。
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall

# ---------- 时区 ----------
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q commit system

# ---------- UPnP / NAT-PMP ----------
# 给 NAS 上的 BT 用。fullcone 只覆盖 TCP，UDP 的入站打洞要靠它。
if [ -f /etc/config/upnpd ]; then
	uci -q set upnpd.config.enabled='1'
	uci -q set upnpd.config.enable_upnp='1'
	uci -q set upnpd.config.enable_natpmp='1'
	# secure_mode=1：perm_rule 里的 int_addr 会被限制为「发起请求的那台主机」，
	# 只允许它给自己开端口，安全性比 0 好很多，BT 用起来也够
	uci -q set upnpd.config.secure_mode='1'
	uci -q set upnpd.config.log_output='0'
	uci -q set upnpd.config.internal_iface='lan'
	# external_iface 不设！默认从 ubus 动态解析，PPPoE 场景下会自动拿到 pppoe-wan。
	# 硬写成 wan 反而可能解析错。
	uci -q delete upnpd.config.external_iface 2>/dev/null

	# ★ 关键：这两项是「向 UPnP 客户端宣告的线路速率」，单位 kbit/s
	#   默认值是 download 1024 / upload 512（1Mbps/0.5Mbps），
	#   BT 客户端会照着这个自我限速，不改的话跑不满线路。
	uci -q set upnpd.config.download='1000000'
	uci -q set upnpd.config.upload='100000'

	# 端口映射只允许 1024 以上，避免被客户端抢走特权端口
	uci -q set upnpd.config.port='5000'
	uci -q set upnpd.@perm_rule[0].action='allow'
	uci -q set upnpd.@perm_rule[0].ext_ports='1024-65535'
	uci -q set upnpd.@perm_rule[0].int_ports='1024-65535'
	uci -q set upnpd.@perm_rule[0].int_addr='0.0.0.0/0'
	uci -q commit upnpd

	/etc/init.d/miniupnpd enable 2>/dev/null
	/etc/init.d/miniupnpd restart 2>/dev/null
fi

exit 0
