#
# seed config — ImmortalWrt 25.12.x / openwrt-25.12 / x86-64 / generic
#
# 用法：
#   放到构建树根目录并改名 .config
#   make defconfig          # 自动补全依赖，切勿手改补出来的三千行
#   make menuconfig         # 需要微调时再进
#
# 所有 CONFIG_PACKAGE_* 项均已对照 ImmortalWrt 25.12.2 官方索引核实存在（87/87）：
#   targets/x86/64/kmods/6.12.103-1-0413601b.../  (.apk)
#   targets/x86/64/packages/            (.apk)
#   packages/x86_64/{base,packages,luci}/ (.apk)
#

# ============ 目标平台 ============
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"

# J1800 = Silvermont。默认是 -Os -pipe，这里换成性能优先并指定架构。
# 如果担心兼容性，可退回 CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=x86-64-v2"
# TARGET_OPTIMIZATION 的 prompt 条件是 `if TARGET_OPTIONS`，而 TARGET_OPTIONS 的
# prompt 条件是 `if DEVEL`（见 toolchain/Config.in:7-12）。
# 不开 DEVEL 时这两个符号都不可见，kconfig 会按 default 重算成 "-Os -pipe"，
# 写在 .config 里的值会被静默丢弃 —— 第一次构建就是这么丢的。
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
# J4125 = Gemini Lake Refresh / Goldmont Plus。
# 有 AES-NI + SHA-NI + VT-d，没有 AVX/AVX2。
# 注意：这份镜像不再兼容 J1800（Silvermont 缺 RDRAND/RDSEED/SHA，会 illegal instruction）。
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=goldmont-plus -mtune=goldmont-plus"

# ============ 镜像 / 引导 ============
# 这台机器实测是 **UEFI x64 启动**：
#   /sys/firmware/efi/fw_platform_size = 64
#   ESP = sda1，里面有 efi/boot/bootx64.efi (634880 B, 2026-01-09)
#   磁盘是纯 GPT（MBR 只有 0xEE 保护性条目），p128 是 bios_grub 类型
# 所以只需要 EFI 镜像。GRUB_IMAGES（BIOS 版）不必要，
# 想多要一份备用镜像时才打开（体积翻倍，构建更久）。
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_BAUDRATE=115200
CONFIG_GRUB_TIMEOUT="5"
CONFIG_GRUB_TITLE="LEDE"

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=128
# 原 448MB 在旧机器上用到 86%（369.8M/440.6M），装几个包就满。
# OpenWrt x86 ext4 镜像的 p2 就是根分区本身，没有 overlayfs，必须留够。
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ============ 版本标识 ============
# 关键前提：从 release tag v25.12.2 构建。
# tag 里的 include/version.mk 默认值就是 25.12.2，
# 而 openwrt-25.12 分支的默认值是 25.12-SNAPSHOT（还会把 apk 源
# 指向 releases/25.12-SNAPSHOT 这个滚动目录）。
#
# 下面几项是「自编后缀」，纯标识用：
# VERSIONOPT 受 IMAGEOPT 控制，IMAGEOPT 又依赖 DEVEL。
# 如果它们被 kconfig 丢弃，不影响正确性 —— tag 的默认值已经是 25.12.2。
# 所以 workflow 里对这几项只做 WARN，致命判据放在 version.mk / feeds.conf.default 上。
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="25.12.2-mengluo"
# 源地址必须是正式版目录，不能用 SNAPSHOT
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/25.12.2"

# ============ SQM / CAKE ============
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y

# ============ WireGuard（内核态）============
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ============ 转发 / 拥塞控制 / NAT ============
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ============ 代理 ============
# passwall 25.12.16 起已是 nftables-only：LUCI_DEPENDS 里硬写
# +kmod-nft-socket +kmod-nft-tproxy +kmod-nft-nat，
# 没有 Iptables_Transparent_Proxy / Nftables_Transparent_Proxy 这两个选项了。
CONFIG_PACKAGE_luci-app-passwall=y
# 代理内核（等价于原固件已装的 xray-core 26.10.10 / sing-box 1.14.4）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# geo 分流数据：原机 /usr/share/v2ray/{geoip.dat 16.5M, geosite.dat 11.5M} 每天更新，
# 不开这两项编出来的固件没有 geo 数据，passwall 的 geoip/geosite 分流规则直接失效
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
# geoview：等价于原固件已装的 geoview 0.2.6（geo 数据查看界面）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=y
# v2ray-plugin + haproxy：原固件都装了（v2ray-plugin 5.49.0 / haproxy 3.0.12），
# 当前进程未启动，但 uci 里有 3 处 haproxy 配置。保持能力对等，免得以后再重编。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y

# ★ 必须显式关闭 —— 这些选项的上游默认值不是 n，在 x86_64 上会自动变 y：
#     INCLUDE_Shadowsocks_Rust_Client  default y             （无条件）
#     INCLUDE_Shadowsocks_Rust_Server  default y if x86_64
#     INCLUDE_Simple_Obfs              default y             （无条件）
#     INCLUDE_SmartDNS                 default y if x86_64
#   其中 Shadowsocks_Rust_* 会拉进 shadowsocks-rust -> rust/host，
#   而 openwrt-25.12 的 rust 1.96.0 在 bootstrap 阶段要下载
#   ci-artifacts.rust-lang.org/.../rust-dev-1.96.0-*.tar.xz，该 URL 已 404，
#   导致 2 小时编译在最后阶段失败。关掉即不再需要 rust，问题消失。
#   以下四项与设备现状一致（原机只装了 xray/sing-box/chinadns-ng/geoview/haproxy/v2ray-plugin）。
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# 以下同样显式关闭，防止上游日后把默认值改成 y：
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set

# ============ LuCI ============
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-theme-argon=y
# 注意：25.12 起 luci-app-argon-config 已并入 luci-theme-argon 3.1.4
#       （LUCI_BASENAME:=argon-config / PKG_PROVIDES:=luci-app-argon-config /
#         conffiles 含 /etc/config/argon），
#       独立包符号 CONFIG_PACKAGE_luci-app-argon-config 已不存在，不要写。
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-netdata=y

# ============ DNS / 内网服务 ============
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y

# ============ 诊断工具 ============
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# ============ 存储 ============
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y

#
# 注意：不要勾 kmod-r8168。
# ImmortalWrt x86/64 generic 的 device_packages 默认就是 kmod-r8169，
# 而主线的 r8169 支持 TSO（你现在跑的 r8168 是 tx-tcp-segmentation: off [fixed]），
# 对 J1800 这种弱 CPU 更友好。两块网卡都是 RTL8111/8168/8211/8411 [10ec:8168] rev07，
# r8169 完全支持。
#
# 如果真出问题（网卡不认），回退方案：加 CONFIG_PACKAGE_kmod-r8168=y 并从
# /etc/modules.d 移除 r8169，或直接 sysupgrade 回旧固件。
#

# ============ 诊断 / 测量（验证整形与排查用）============
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_speedtest-netperf=y
CONFIG_PACKAGE_socat=y
# 不在路由器上装 nmap：扫描在 Mac 上做，装了也是 ~10MB(libstdcpp6/libpcre2/libpcap) 的死重量
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_lscpu=y
# PVE / KVM 客户机代理：让 PVE 面板能读到 IP、执行优雅关机、快照前 fsfreeze。
# 注意：virtio 网卡/磁盘驱动不需要额外装 —— CONFIG_VIRTIO_NET / VIRTIO_BLK /
# SCSI_VIRTIO / VIRTIO_PCI 在 target/linux/generic/config-6.12 里都是 =y 内建的。
CONFIG_PACKAGE_qemu-ga=y

# ============ 监控 ============
# 按主机流量统计（BT 场景排查「谁在吃上行」）
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
# 月度流量统计
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_vnstati2=y
CONFIG_PACKAGE_luci-app-vnstat2=y
# 磁盘健康（这台已经跑了 104 天没重启）
CONFIG_PACKAGE_smartmontools=y

# ============ 日常工具 ============
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_luci-app-commands=y
